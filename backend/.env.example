PANJRAKH_CORS_ORIGINS=["http://localhost:3000"]

# OpenAI-compatible provider
# chat mode: {BASE}/chat/completions   e.g. https://api.gapgpt.app/v1 or https://api.openai.com/v1
# responses mode (Kie): {BASE}/openai/v1/responses  e.g. https://api.kie.ai
PANJRAKH_LLM_BASE_URL=https://api.gapgpt.app/v1
PANJRAKH_LLM_API_KEY=sk-...
PANJRAKH_LLM_MODEL=gpt-4o-mini
PANJRAKH_LLM_API_MODE=auto
PANJRAKH_LLM_TIMEOUT_SECONDS=90
PANJRAKH_LLM_TEMPERATURE=0.75
